+struct pid *find_neg_vpid(pid_t vnr, struct pid_namespace *ns)
+{
+	struct hlist_head *hhead;
+	struct pid *pid;
+	struct upid *upid;
+
+	if (vnr >= 0 || !ns)
+		return NULL;
+
+	hhead = &negpid_hash[negpid_hashfn(vnr, ns)];
+
+	rcu_read_lock();
+	hlist_for_each_entry_rcu(pid, hhead, numbers[ns->level].pid_chain) {
+		upid = pid->numbers + ns->level;
+		if (upid->nr == vnr && upid->ns == ns) {
+			get_pid(pid);
+			rcu_read_unlock();
+			return pid;
+		}
+	}
+	rcu_read_unlock();
+	return NULL;
